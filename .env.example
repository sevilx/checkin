# ===== 站点凭据 =====
# Cookie 等于账号密码：这个文件只放本机 / NAS，.gitignore 已忽略，别提交
# 拿法：浏览器登录目标站 → F12 → Application → Cookies → 选域名 → Ctrl+A / Ctrl+C

# 百度网盘（含 BDUSS、STOKEN）
BAIDUWP_COOKIE=
# 哔哩哔哩（含 SESSDATA、bili_jct）
BILIBILI_COOKIE=
# 飞牛 NAS 论坛（含 pvRK_2132_auth）
FNNASCLUB_COOKIE=
# 福利吧论坛 wnflb2023.com（Discuz，含 S5r8_2132_auth、S5r8_2132_saltkey）
# 取法：F12 → 网络 → 任意请求 → 请求标头 → Cookie 整行复制
WNFLB_COOKIE=
# 吾爱破解 52pojie.cn（Discuz 任务系统签到，含 htVC_2132_auth、htVC_2132_saltkey）
# 注意：站点有瑞数动态防护（不是 Cloudflare），纯 HTTP 常被拦成 JS 挑战页，
#       Cookie 里的 WZWS 动态凭证几小时就过期，建议浏览器访问后立刻跑
POJIE_COOKIE=
# 卡饭论坛 bbs.kafan.cn（Discuz，含 r6pb_69df_auth、r6pb_69df_saltkey）
# 站点是 GBK 编码，程序已处理；签到现在是"登录即自动完成"，本项主要做状态确认
KAFAN_COOKIE=
# 恩山无线论坛 right.com.cn（Discuz X3.5 + erling_qd 签到插件，含 rHEX_2132_auth、rHEX_2132_saltkey）
# 注意：这站挂了阿里云 ESA，机房 IP 容易被 521 拦，建议只在家宽环境的 NAS 上跑
ENSHAN_COOKIE=
# 什么值得买（sess 不能少）
SMZDM_COOKIE=
# 百度贴吧（含 BDUSS）
TIEBA_COOKIE=
# V2EX：整段 Cookie 或只填 A2
V2EX_COOKIE=
V2EX_A2=
# NodeSeek（至少含 session；只抄 cf_clearance 没用，它和 IP 绑定）
# 站点有 Cloudflare 挑战，程序会自动换浏览器指纹（curl_cffi）重试
NODESEEK_COOKIE=
NODESEEK_METHOD=random
# LinuxDo（必须有 _t，它是 HttpOnly，控制台 document.cookie 里没有）
# 取法：F12 → 网络 → 任意请求 → 请求标头 → Cookie 整行复制
LINUXDO_COOKIE=
# 浏览几个主题（默认 3，上限 10）
# LINUXDO_BROWSE=3
# 设 1 才上报阅读时长：只按请求实际耗时上报，不伪造（默认关，见 README）
# LINUXDO_READ_REPORT=0
# 点赞配额（默认 0 关闭，上限 5，带随机间隔，遇到 429 自动停）
# LINUXDO_LIKE=0
# 天翼云盘 189：账号密码（SDK 不走代理）
TY189_USERNAME=
TY189_PASSWORD=
# 189 备用通道：账号密码登录被设备校验挡住时，只填 SSON 也能登
# 取法：浏览器登录 cloud.189.cn → F12 → Application → Cookies → 复制 SSON 的值
TY189_SSON=

# 盘就是六 pan946.com（Xiuno BBS，签到接口 POST my-sign.htm）
# 推荐填邮箱 + 密码：站点登录不需要验证码，程序每天现登现签，永远不会过期
PAN946_EMAIL=
PAN946_PASSWORD=
# 不想填密码就改用 cookie（浏览器整行复制，要含 bbs_uid、bbs_token）；填了密码可不填
PAN946_COOKIE=

# 值里有空格、分号时用引号整段包住；在 GitHub Secrets 里则不要加引号，只填值
# 例：BAIDUWP_COOKIE='BAIDUID=xxx; BDUSS=yyy; STOKEN=zzz'
#
# 用单引号还是双引号，别选错：
#   单引号 '...'  → 里面的字符原样保留，不做任何转义和替换。【cookie 一律用这个】
#   双引号 "..."  → Docker 会解释 \n \t \" 这类转义，还会把 $VAR 当变量替换掉
# 所以只要 cookie 值里出现 ASCII 双引号（"）或美元符号（$），用双引号就会报
#   unexpected character "\"" in variable name
# 或者把 $ 后面的内容悄悄替换成空字符串。Google Analytics 的 _ga 类 cookie
# 和部分站点的 JSON 值里这两种字符都有，务必用单引号。
# 只有值里本身含单引号（'）时才反过来用双引号，并把内部的 " 写成 \"、$ 写成 \$

# 多账号：字段名后加 _2 / _3，数量不限
# V2EX_COOKIE_2='A2=xxx'
# V2EX_NAME_2=小号                        # 备注，显示在通知和面板上
# V2EX_PROXY_2=http://192.168.1.2:7890    # 只对这个账号生效
# TY189_USERNAME_2=13900000000
# TY189_PASSWORD_2=xxx
# TY189_NAME_2=备用号

# ===== 代理 =====
# 站点级：<KEY>_PROXY，只对该站点生效
# V2EX_PROXY=http://192.168.1.2:7890
# NODESEEK_PROXY=socks5h://192.168.1.2:7891
# 全局兜底：账号没单独配代理时用它
# GLOBAL_PROXY=http://192.168.1.2:7890

# ===== 推送渠道（填哪个用哪个）=====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_HOST=https://api.telegram.org
SC3_PUSH_KEY=
PUSHPLUS_TOKEN=
WECOM_WEBHOOK=
FEISHU_WEBHOOK=
BARK_URL=
GOTIFY_URL=
GOTIFY_TOKEN=
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh

# ===== 行为开关 =====
# 只跑这些站点（逗号分隔，留空=全部已配置）
ENABLED_SITES=
# 有站点失败时是否让进程返回非 0（Actions 会变红）
FAIL_ON_ERROR=true

# ===== 网页面板（仅 NAS / 本地部署用）=====
# 留空则首次启动随机生成并打印到容器日志
PANEL_PASSWORD=
PANEL_TITLE=我的签到
PANEL_PORT=8080
PANEL_ENABLED=true
PANEL_ALLOW_RUN=true
# 是否允许在网页上改口令 / 改 cookie / 改代理 / 改定时
PANEL_ALLOW_EDIT=true
# 走 HTTPS 反代时设成 true，cookie 才带 Secure 标记
PANEL_COOKIE_SECURE=false
# 会话有效期（天）
PANEL_SESSION_DAYS=7

# ===== 定时（Docker 部署时用）=====
# 每天几点跑，可写多个：09:10 或 09:10,21:30（容器时区）
# 面板「设置 → 定时运行」里保存过就以面板为准，这里的值不再生效
# 留空（RUN_AT=）＝ 单次模式：跑一次就退出，交给外部 cron
RUN_AT=09:10
RUN_ON_START=false
